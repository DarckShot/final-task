# Example only: generate a private .env with scripts/init-env.js before deployment.
AUTHOR_LOGIN=sergey_krasn
AUTHOR_FULL_NAME=Сергей Краснопольский
# Generate each secret separately: openssl rand -hex 32
API_TOKEN=
# Independent Bearer token for the reviewer; do not reuse API_TOKEN.
REVIEWER_API_TOKEN=
# The app container reaches PostgreSQL by the Compose service name, db.
DATABASE_URL=postgresql://tasks_app:CHANGE_ME@db:5432/tasks_db
PORT=3000
# Optional trusted CA for remote PostgreSQL with sslmode=verify-full
# PGSSLROOTCERT=/absolute/path/to/ca.pem
# Migration/provisioning only, never pass administrator credentials to the web app
ADMIN_DATABASE_URL=
APP_DB_PASSWORD=
REVIEWER_DB_PASSWORD=
# Server loopback; from another machine use the restricted SSH tunnel and its local port.
REVIEWER_DATABASE_URL=postgresql://tasks_reviewer:CHANGE_ME@127.0.0.1:5432/tasks_db
POSTGRES_PASSWORD=
DOMAIN=
ACME_EMAIL=
# Dedicated disposable PostgreSQL database for tests only
TEST_DATABASE_URL=
